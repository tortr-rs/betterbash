Exit Status:
Returns the exit status of `chown'.
$END

$BUILTIN word-count
$DOCNAME word_count
$FUNCTION word_count_builtin
$SHORT_DOC word-count [arg ...]
Clearer name for `wc'.

Runs the real `wc' command with the given arguments.  bbash additive
builtin; `wc' itself is completely unchanged and still works normally.

Exit Status:
Returns the exit status of `wc'.
$END

#include <config.h>

#if defined (HAVE_UNISTD_H)
#  ifdef _MINIX
#    include <sys/types.h>
#  endif
#  include <unistd.h>
#endif

#include "../shell.h"
#include "common.h"

int
list_builtin (WORD_LIST *list)
{
  return run_real_command ("ls", list);
}

int
copy_builtin (WORD_LIST *list)
{
  return run_real_command ("cp", list);
}

int
move_builtin (WORD_LIST *list)
{
  return run_real_command ("mv", list);
}

int
delete_builtin (WORD_LIST *list)
{
  return run_real_command ("rm", list);
}

int
make_dir_builtin (WORD_LIST *list)
{
  return run_real_command ("mkdir", list);
}

int
ownership_builtin (WORD_LIST *list)
{
  return run_real_command ("chown", list);
}

int
word_count_builtin (WORD_LIST *list)
{
  return run_real_command ("wc", list);
}
