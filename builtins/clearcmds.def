$BUILTIN stop-process
$DOCNAME stop_process
$FUNCTION stop_process_builtin
$SHORT_DOC stop-process [arg ...]
Clearer name for `kill'.

Runs the shell's own `kill' (so job specs like %1 still work) with the
given arguments.  bbash additive builtin; `kill' itself is completely
unchanged and still works normally.

Exit Status:
Returns the exit status of `kill'.
$END

#include <config.h>

#if defined (HAVE_UNISTD_H)
#  ifdef _MINIX
#    include <sys/types.h>
#  endif
#  include <unistd.h>
#endif

#include "../shell.h"
#include "common.h"

int
list_builtin (WORD_LIST *list)
{
  return run_real_command ("ls", list);
}

int
copy_builtin (WORD_LIST *list)
{
  return run_real_command ("cp", list);
}

int
move_builtin (WORD_LIST *list)
{
